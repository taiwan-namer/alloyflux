# 必填：≥32 字元（加密 OAuth 貨源 + Session HMAC）
APP_SECRET=please-change-me-to-a-long-random-string-32chars

# Supabase Postgres（唯一資料庫）。建議只設在 Vercel Production，勿放本機以免外洩。
# 建議 Transaction pooler（埠 6543），例如：
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# 也接受 POSTGRES_URL / SUPABASE_DB_URL
# 本機未設時：sources／admin／wallet／chat… 等 API 自動代理到下方雲端站（同一份 DB）
DATABASE_URL=

# 線上站台公開網址（非密鑰）。本機無 DATABASE_URL 時所有 DB API 走此站
NEXT_PUBLIC_APP_URL=https://alloyflux.vercel.app
OAUTH_CLOUD_API_BASE=https://alloyflux.vercel.app

# Supabase 專案 URL 與前端公開金鑰（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
# 新版 Publishable key（sb_publishable_...）；舊專案可改填 ANON key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 計費：1 點 = $0.003 上游成本；買家扣點再乘 markup
USD_PER_POINT=0.003
PRICE_MARKUP=1.05

# 新註冊贈點
INITIAL_FREE_POINTS=50

# 管理員 Email（逗號分隔）— 可進 /sources /nodes、產兌換碼
ADMIN_EMAILS=you@example.com

# 封測後門：對應到 ADMIN_EMAILS 第一位的錢包（需該 email 已註冊）
PLATFORM_API_KEYS=sk_test_mvp_change_me

# 封測儲值金鑰（正式上線請刪除這三行）
# 帳號頁「兌換開通」輸入此金鑰可重複入帳；或設 TEST_AUTO_TOPUP=1 於餘額<100 自動補點
# TEST_TOPUP_KEY=ALLOY-TEST-TOPUP
# TEST_TOPUP_POINTS=10000
# TEST_AUTO_TOPUP=1

# Node Agent 註冊（CLI）：Authorization: Bearer …
AGENT_REGISTER_TOKEN=change-me-register-token

# 可選：網站帳號 Google 登入（買家／回訪供給者登入網站；用你自己建的 Google「網頁應用程式」OAuth client）
# BUYER_GOOGLE_CLIENT_ID=
# BUYER_GOOGLE_CLIENT_SECRET=
# BUYER_GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# 供給端掛載 Antigravity（Gemini + Claude & GPT 訂閱水庫）：
# 程式已固定走「Antigravity 官方桌面 CLI Client + Loopback URL 貼回法」，不必設定任何 GEMINI_OAUTH_* 環境變數！
# （自建 Web client 換出的 token 無 Antigravity 權限會 401，故兩套職責徹底分離）

SESSION_DAYS=30

# 可選：平台直連備援
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
